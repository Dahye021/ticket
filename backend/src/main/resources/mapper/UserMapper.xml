<?xml version="1.0" encoding="8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ticket.backend.mapper.UserMapper">
    <select id="findByEmail"
            parameterType="string"
            resultType="com.ticket.backend.domain.Users">
        SELECT
            user_id,
            email,
            password,
            name,
            phone,
            role,
        FROM users
        WHERE email = #{email}
    </select>
</mapper>