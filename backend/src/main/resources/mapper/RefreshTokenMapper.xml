<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTO Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ticket.backend.mapper.RefreshTokenMapper">

    <insert id="insertRefreshToken">
        INSERT INTO refresh_tokens (
            user_id,
            refresh_token,
            expires_at,
            revoked,
            created_at
        )
        VALUES (
            #{userId},
            #{refreshToken},
            #{expiresAt},
            #{revoked},
            #{createdAt}
        )
    </insert>
</mapper>